# ---------------------------------------------------------------------------
# SchoolBook API - environment template
# Copy to backend/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Public URL of the frontend (comma-separated allowlist in production).
# Required when NODE_ENV=production.
FRONTEND_URL=http://localhost:3000

# Number of reverse proxies in front of the app (Render/Railway/Fly = 1).
# Leave empty when running directly without a proxy.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# DATABASE_URL: pooled connection used by the application.
# DIRECT_URL:   direct connection used by Prisma migrations only.
# Managed providers (Neon/Supabase) require TLS: ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/schoolbook?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/schoolbook?sslmode=require

# ---------------------------------------------------------------------------
# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. Rotating this invalidates all access tokens.
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# ---------------------------------------------------------------------------
# Google OAuth (optional). Leave both empty to disable Google sign-in.
# Callback URL must be: <PUBLIC_ORIGIN>/api/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_AUTO_PROVISION=false
GOOGLE_AUTO_PROVISION_ROLE=STUDENT
GOOGLE_ALLOWED_DOMAINS=

# Where the browser lands after a successful Google login.
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/app

# ---------------------------------------------------------------------------
# Supabase (optional - file storage only; the database is plain PostgreSQL)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Transactional email (optional - password reset / verification / circulars)
# All four SMTP values must be present for email delivery to be enabled.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="SchoolBook <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Demo data (development only). Production refuses demo seeding unless
# SEED_DEMO_PASSWORD is set explicitly.
# ---------------------------------------------------------------------------
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# One-time production bootstrap. Run:
#   npm run bootstrap:school --prefix backend
# The script refuses to overwrite an existing school slug or user email.
# Remove these values from the shell after bootstrap.
# ---------------------------------------------------------------------------
BOOTSTRAP_SCHOOL_NAME=
BOOTSTRAP_SCHOOL_SLUG=
BOOTSTRAP_PRINCIPAL_EMAIL=
BOOTSTRAP_PRINCIPAL_FIRST_NAME=
BOOTSTRAP_PRINCIPAL_LAST_NAME=
BOOTSTRAP_PRINCIPAL_PASSWORD=
