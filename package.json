{
  "name": "schoolbook-sms",
  "version": "1.0.0",
  "description": "SchoolBook School Management System (SMS) Framework",
  "main": "dist/backend/server.js",
  "type": "module",
  "scripts": {
    "build:app": "esbuild src/frontend/ts/main.ts --bundle --outfile=src/frontend/app.js --sourcemap --target=es2022",
    "build:auth": "esbuild src/frontend/ts/login.ts src/frontend/ts/reset-password.ts src/frontend/ts/verify-email.ts --bundle --outdir=src/frontend --sourcemap --target=es2022",
    "build:fe": "npm run build:app && npm run build:auth",
    "watch:app": "esbuild src/frontend/ts/main.ts --bundle --outfile=src/frontend/app.js --sourcemap --target=es2022 --watch",
    "watch:auth": "esbuild src/frontend/ts/login.ts src/frontend/ts/reset-password.ts src/frontend/ts/verify-email.ts --bundle --outdir=src/frontend --sourcemap --target=es2022 --watch",
    "watch:fe": "npm run watch:app",
    "build:be": "cd backend && npm run build",
    "build": "npm run build:fe && npm run build:be",
    "typecheck": "tsc --noEmit",
    "start": "cd backend && npm run start:prod",
    "dev": "cd backend && npm run start:dev",
    "seed:demo": "cd backend && node prisma/seed-demo.mjs",
    "bootstrap:school": "cd backend && node prisma/bootstrap-school.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "esbuild": "^0.28.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
