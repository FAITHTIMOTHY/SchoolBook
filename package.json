{
  "name": "schoolbook-sms",
  "version": "1.0.0",
  "description": "SchoolBook School Management System (SMS) Framework",
  "main": "dist/backend/server.js",
  "type": "module",
  "scripts": {
    "build:fe": "esbuild src/frontend/ts/main.ts --bundle --outfile=src/frontend/app.js --sourcemap --target=es2022",
    "watch:fe": "esbuild src/frontend/ts/main.ts --bundle --outfile=src/frontend/app.js --sourcemap --target=es2022 --watch",
    "build:be": "tsc",
    "build": "npm run build:fe && npm run build:be",
    "typecheck": "tsc --noEmit",
    "start": "node dist/backend/server.js",
    "dev": "tsx watch src/backend/server.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "esbuild": "^0.28.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
